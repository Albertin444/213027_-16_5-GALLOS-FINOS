# =========================
# Unity.gitignore
# =========================

# --- Carpetas que Unity regenera automáticamente ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
MemoryCaptures/

# --- Archivos de caché del Package Manager ---
[Pp]ackages/com.unity.assetbundlebrowser/
[Pp]ackageCache/

# --- Cache de sistema ---
sysinfo.txt

# --- Archivos de la Asset Store ---
Assets/AssetStoreTools*

# --- Archivos de compilación ---
*.apk
*.aab
*.unitypackage

# --- Archivos de configuración personal ---
.vscode/
.idea/
*.suo
*.user
*.userprefs
*.csproj
*.pidb
*.sln
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- Archivos generados por VS / Rider ---
*.db
*.db-wal
*.db-shm
*.DotSettings
*.csproj
*.sln
*.tmproj

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- TextMesh Pro ---
[Tt]extMeshPro/

# --- Otros ---
*.booproj
*.swp
*.tmp
*.bak
*.unityproj
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Línea final ---
# Asegura que Git maneje los finales de línea correctamente
* text=auto
